# Copy this file to .env.local for optional local configuration.
# OpenEval is local-first; the default data root is ./data.

# Keep mutable history and SQLite state outside the checkout when desired.
# OPENEVAL_DATA_ROOT=/absolute/path/to/openeval-data

# Harness selection. The UI and CLI can also choose a harness explicitly.
# OPENEVAL_DEFAULT_HARNESS=codex
# CLAUDE_BIN=/absolute/path/to/claude
# CODEX_BIN=/absolute/path/to/codex
# NCODE_BIN=/absolute/path/to/ncode

# Optional model-judge configuration. The deterministic stub needs no key.
# JUDGE_HARNESS=codex
# JUDGE_MODEL=gpt-5.6-luna
# JUDGE_REASONING_EFFORT=high
# OPENROUTER_API_KEY=
# OPENEVAL_FORBIDDEN_JUDGE_SOURCES=

# Optional local safety and performance controls.
# OPENEVAL_ALLOWED_HOSTS=localhost,127.0.0.1
# OPENEVAL_SCAN_BUDGET_MS=30000
# OPENEVAL_TRANSCRIPT_CURSOR_SECRET=replace-with-a-local-random-secret
# OPENEVAL_SSE_POLL_MS=600
# OPENEVAL_SSE_HEARTBEAT_MS=15000
